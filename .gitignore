# =============================================================================
# WordPress Bedrock .gitignore
# =============================================================================

# Composer
/vendor/

# WordPress core (installed via Composer)
/web/wp/

# WordPress content directories managed by Composer
/web/app/plugins/*
!/web/app/plugins/.gitkeep
/web/app/themes/*
!/web/app/themes/.gitkeep

# Must-use plugins installed via Composer (keep custom ones)
/web/app/mu-plugins/*/
!/web/app/mu-plugins/health-check.php
!/web/app/mu-plugins/upsun-security.php

# Uploads (managed by Upsun mounts)
/web/app/uploads/

# Cache
/web/app/cache/

# WordPress upgrade files
/web/app/upgrade/

# Environment files (never commit secrets!)
.env
.env.*
!.env.example

# IDE & Editors
.idea/
.vscode/
*.swp
*.swo
*~

# OS Files
.DS_Store
Thumbs.db
Desktop.ini
nul

# Logs
*.log
/web/app/debug.log

# Node (if using build tools)
node_modules/

# Local development
*.local
.wp-cli/
