# WordPress Bedrock - Local Development Configuration
# Copy this file to .env and adjust values

# Database
DB_NAME=wordpress
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost

# Table prefix
TABLE_PREFIX=wp_

# URLs
WP_HOME=http://localhost
WP_SITEURL=${WP_HOME}/wp

# Environment: development, staging, production
WP_ENV=development

# WordPress Admin (for automated install)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=changeme
WP_ADMIN_EMAIL=admin@localhost

# Security Keys (generate at https://api.wordpress.org/secret-key/1.1/salt/)
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'

# Optional: Secret admin path (set to enable login protection)
# WP_ADMIN_SECRET_PATH=your-secret-path

# Optional: Redis (set to true if using local Redis)
# ENABLE_REDIS=false
